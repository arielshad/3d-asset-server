---
interface Props { class?: string; id?: string }
// Each instance needs its own gradient id: the header and footer both render a logo.
const { class: className = "size-6", id = "logo" } = Astro.props;
const gradient = `${id}-gradient`;
---
<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={gradient} x1="4" y1="3" x2="28" y2="29" gradientUnits="userSpaceOnUse">
      <stop stop-color="var(--color-primary)" />
      <stop offset="1" stop-color="var(--color-brand-2)" />
    </linearGradient>
  </defs>
  <path d="M16 3 4.5 9.5v13L16 29l11.5-6.5v-13L16 3Z" stroke={`url(#${gradient})`} stroke-width="2.2" stroke-linejoin="round" />
  <path d="M4.5 9.5 16 16l11.5-6.5M16 16v13" stroke={`url(#${gradient})`} stroke-width="2.2" stroke-linejoin="round" />
  <circle cx="16" cy="16" r="2.4" fill={`url(#${gradient})`} />
</svg>
