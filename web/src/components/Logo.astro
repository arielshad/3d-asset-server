---
interface Props { class?: string }
const { class: className = "size-6" } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="logo-g" x1="4" y1="3" x2="28" y2="29" gradientUnits="userSpaceOnUse">
      <stop stop-color="var(--color-primary)" />
      <stop offset="1" stop-color="var(--color-brand-2)" />
    </linearGradient>
  </defs>
  <path d="M16 3 4.5 9.5v13L16 29l11.5-6.5v-13L16 3Z" stroke="url(#logo-g)" stroke-width="2.2" stroke-linejoin="round" />
  <path d="M4.5 9.5 16 16l11.5-6.5M16 16v13" stroke="url(#logo-g)" stroke-width="2.2" stroke-linejoin="round" />
  <circle cx="16" cy="16" r="2.4" fill="url(#logo-g)" />
</svg>
