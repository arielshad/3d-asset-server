---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/collections/Breadcrumbs.astro";
import CollectionCard from "@/components/collections/CollectionCard.astro";
import { HUBS, allCollections, dateFmt, hubPath, latest } from "@/lib/collections";
import { breadcrumbs, collectionPage } from "@/lib/schema";
import { SOURCE_COUNT } from "@/lib/site";

const all = await allCollections();
const updated = latest(all);
const title = "Free 3D asset collections";
const description = `Curated collections of free HDRIs, PBR textures, 3D models and game assets, picked from ${SOURCE_COUNT} sites with licences shown and refreshed daily.`;
const trail = [{ name: "Home", path: "/" }, { name: "Asset collections", path: "/assets" }];
---

<BaseLayout
  title={title}
  description={description}
  markdown="/assets.md"
  schema={[
    collectionPage({ title, description, path: "/assets", dateModified: updated, links: [...HUBS.map((h) => ({ name: h.title, path: hubPath(h) })), ...all.map((c) => ({ name: c.topic.data.title, path: c.path }))] }),
    breadcrumbs(trail),
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs trail={trail} />
    <header class="mt-6 max-w-3xl">
      <p class="text-sm font-medium text-primary">3D Asset Server</p>
      <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        Each collection answers one need, such as a sunset HDRI, a brick wall material or a low-poly tree, with the best free matches from {SOURCE_COUNT} asset sites side by side. Every card shows its source and licence, and the lists are refreshed from a live search every day.
      </p>
      {updated && <p class="mt-3 text-sm text-muted-foreground">{all.length} collections, updated <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>.</p>}
    </header>

    {HUBS.map((hub) => {
      const cs = all.filter((c) => c.hub.id === hub.id);
      return cs.length ? (
        <section class="mt-14" aria-labelledby={`hub-${hub.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id={`hub-${hub.id}`} class="text-2xl font-semibold tracking-tight"><a href={hubPath(hub)} class="hover:text-primary">{hub.title}</a></h2>
            <a href={hubPath(hub)} class="text-sm text-primary hover:underline">All {hub.name.toLowerCase()} →</a>
          </div>
          <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {cs.map((c) => <CollectionCard collection={c} />)}
          </ul>
        </section>
      ) : null;
    })}

    <p class="mt-16 text-sm text-muted-foreground">
      Looking for something else? <a href="/search" class="text-primary hover:underline">Search all {SOURCE_COUNT} sites</a>, or see <a href="/docs/sources" class="text-primary hover:underline">every source and its licence</a>.
    </p>
  </div>
</BaseLayout>
