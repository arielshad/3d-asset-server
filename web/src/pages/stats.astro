---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StatsDashboard from "@/components/stats/StatsDashboard";
import { aboutPage, breadcrumbs } from "@/lib/schema";
import { CC0_COUNT, DIRECT_DOWNLOAD_COUNT, INTEGRATIONS, PROVIDERS, SOURCE_COUNT } from "@/lib/site";

const title = "Usage statistics";
const description = `Live usage of 3D Asset Server: searches from the web, REST API and AI agents, downloads, MCP tool calls and the health of all ${SOURCE_COUNT} asset sources.`;
const names = Object.fromEntries(PROVIDERS.map((p) => [p.id, p.name]));
const count = (key: "access" | "pricing", value: string) => PROVIDERS.filter((p) => p[key] === value).length;
const catalog = [
  { value: SOURCE_COUNT, label: "sources searched" },
  { value: DIRECT_DOWNLOAD_COUNT, label: "with direct downloads" },
  { value: CC0_COUNT, label: "CC0 / public-domain sources" },
  { value: count("access", "api"), label: "searched through an official API" },
];
const recent = INTEGRATIONS.slice(0, 6);
const dateFmt = new Intl.DateTimeFormat("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title={title}
  description={description}
  markdown="/stats.md"
  schema={[aboutPage({ title, description, path: "/stats", type: "WebPage" }), breadcrumbs([{ name: "Home", path: "/" }, { name: title, path: "/stats" }])]}
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <header class="max-w-3xl">
      <p class="text-sm font-medium text-primary">3D Asset Server</p>
      <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Usage statistics</h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        How people and AI agents use 3D Asset Server, and how each of the {SOURCE_COUNT} asset sites is responding. Counts are anonymous totals: no search terms, IP addresses or accounts are shown or stored with them.
      </p>
    </header>

    <section class="mt-10" aria-labelledby="usage">
      <h2 id="usage" class="sr-only">Usage</h2>
      <StatsDashboard client:load names={names} />
    </section>

    <section class="mt-16" aria-labelledby="catalog">
      <h2 id="catalog" class="text-xl font-semibold tracking-tight">Catalog</h2>
      <dl class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {catalog.map((c) => (
          <div class="rounded-xl border bg-card/40 p-5">
            <dt class="text-sm text-muted-foreground">{c.label}</dt>
            <dd class="mt-2 text-3xl font-semibold tabular-nums tracking-tight">{c.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-16" aria-labelledby="recent">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="recent" class="text-xl font-semibold tracking-tight">Recently added sources</h2>
        <a href="/docs/sources" class="text-sm text-primary hover:underline">All sources &amp; licences →</a>
      </div>
      <p class="mt-1 text-sm text-muted-foreground">
        New asset sites are checked for every day. A site is added only when its terms allow automated search and its integration passes the test suite against the live site.
      </p>
      <ul class="mt-4 divide-y rounded-xl border">
        {recent.map((i) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
            <a href={`/docs/sources#${i.id}`} class="font-medium hover:underline">{i.name}</a>
            <span class="text-muted-foreground">
              Added <time datetime={i.addedAt}>{dateFmt.format(new Date(`${i.addedAt}T00:00:00Z`))}</time>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 max-w-3xl" aria-labelledby="method">
      <h2 id="method" class="text-xl font-semibold tracking-tight">How these numbers are counted</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted-foreground">
        <li>Every search, asset view, download and MCP tool call increments a counter on the server. The counters are labelled only by surface (website, REST API, MCP), client family (for example "Claude Code" or "curl"), asset type and source.</li>
        <li>Totals for the last 24 hours and 7 days come from the server's Prometheus metrics, so they are approximate to within a few events.</li>
        <li>Source health counts how often each site answered a search, failed or timed out, and how long it took.</li>
        <li>The same data is available as JSON at <a class="text-primary hover:underline" href="/v1/stats">/v1/stats</a> (<a class="text-primary hover:underline" href="/docs/api/reference#op-getStats">reference</a>). See the <a class="text-primary hover:underline" href="/privacy">privacy policy</a> for what is logged.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
